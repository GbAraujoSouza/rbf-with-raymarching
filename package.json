{
  "name": "rbf-raymarching",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal WebGPU starter with TypeScript and webpack.",
  "scripts": {
    "start": "npm run build && npm run serve",
    "dev": "webpack serve --mode development",
    "build": "webpack --config webpack.config.js",
    "typecheck": "tsc --noEmit",
    "serve": "live-server dist --cors"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "live-server": "^1.2.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.8.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  }
}
